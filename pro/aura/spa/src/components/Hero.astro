---
import { site } from '../data/site';
---
<section class="section" aria-labelledby="hero-title">
  <div class="container">
    <div class="grid">
      <div class="left-col">
        <div class="overflow-hidden">
          <h1 id="hero-title" class="heading-h1 no-margin slide-up">
            <span data-i18n="hero.title">{site.hero.title}</span> <span class="highlight" data-i18n="hero.highlight">{site.hero.highlight}</span> <span data-i18n="hero.titleEnd">{site.hero.titleEnd}</span>
          </h1>
        </div>
        <div class="spacer-32"></div>
      </div>
      <div class="right-col">
        <div class="overflow-hidden">
          <p class="paragraph paragraph-large fade-in" data-i18n="hero.subtitle">{site.hero.subtitle}</p>
        </div>
        <div class="overflow-hidden" style="padding-top:8px;">
          <div class="fade-in" style="display:flex;gap:12px;flex-wrap:wrap;">
            <a href={site.hero.primaryHref} class="button" data-i18n="hero.primaryCta">{site.hero.primaryCta}</a>
            <a href={site.hero.secondaryHref} class="button button-outline" data-i18n="hero.secondaryCta">{site.hero.secondaryCta}</a>
          </div>
        </div>
      </div>
    </div>
    <div class="spacer-32"></div>
    <div class="hero-image-wrap fade-in">
      <div class="spacer-32"></div>
      <img
        src={site.hero.image}
        alt="Spa sanctuary"
        class="hero-image"
        width="1292" height="600"
        fetchpriority="high"
      />
    </div>
  </div>
</section>
