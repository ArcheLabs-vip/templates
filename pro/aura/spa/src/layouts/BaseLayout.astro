---
import { site } from '../data/site';
import '../styles/global.css';
interface Props { title?: string; description?: string; }
const { title = site.title, description = site.description } = Astro.props;
---
<!doctype html>
<html lang="en" class:list={{ 'has-demo-notice': site.demo }}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6f5f0" />
    <meta name="color-scheme" content="light" />
    {site.demo && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={site.hero.image} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Unbounded:wght@300;400;500;600;700&family=Work+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    {site.demo && <p class="demo-notice">{site.demoNotice}</p>}
    <slot />
    <script>
      // Scroll animations for entry elements
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
          }
        });
      }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
      document.querySelectorAll('.fade-in, .slide-up').forEach(el => observer.observe(el));

      // Hero scroll rotation effect (parallax straightening)
      const heroWrap = document.querySelector('.hero-image-wrap');
      if (heroWrap) {
        // Use a generic type or cast appropriately in TS. In Astro client script, it's plain JS.
        const wrapEl = heroWrap as HTMLElement;
        window.addEventListener('scroll', () => {
          const scrollY = window.scrollY;
          // Progress from 0 to 1 over the first 400px of scroll
          let progress = scrollY / 400;
          if (progress > 1) progress = 1;
          
          // Image goes from -4deg to 0deg
          const imgRot = -4 * (1 - progress);
          // Bg goes from 3deg to 0deg
          const bgRot = 3 * (1 - progress);
          
          wrapEl.style.setProperty('--img-rot', `${imgRot}deg`);
          wrapEl.style.setProperty('--bg-rot', `${bgRot}deg`);
        }, { passive: true });
      }
      // Image Parallax Effect
      const parallaxImages = document.querySelectorAll('.parallax-image');
      window.addEventListener('scroll', () => {
        if (!parallaxImages || parallaxImages.length === 0) return;
        const windowHeight = window.innerHeight;
        parallaxImages.forEach((img) => {
          const el = img as HTMLElement; // Cast in standard JS
          const wrap = el.parentElement;
          if (!wrap) return;
          const rect = wrap.getBoundingClientRect();
          
          if (rect.top <= windowHeight && rect.bottom >= 0) {
            const totalDistance = windowHeight + rect.height;
            let progress = (windowHeight - rect.top) / totalDistance; 
            if (progress < 0) progress = 0;
            if (progress > 1) progress = 1;
            
            // Map progress 0 -> 1 to translateY -8% -> 8%
            const yOffset = (progress - 0.5) * 16; 
            
            el.style.transform = `scale(1.2) translateY(${yOffset.toFixed(2)}%)`;
          }
        });
      }, { passive: true });
    </script>
    <script>
      // ── i18n Translation Engine ──
      import { i18n } from '../data/i18n';

      type Lang = 'en' | 'pt';
      const STORAGE_KEY = 'lotusw-lang';

      function getLang(): Lang {
        const stored = localStorage.getItem(STORAGE_KEY);
        if (stored === 'en' || stored === 'pt') return stored;
        return 'pt'; // default to Portuguese
      }

      function applyTranslations(lang: Lang) {
        const dict = i18n[lang] as Record<string, string>;

        // Translate textContent
        document.querySelectorAll('[data-i18n]').forEach(el => {
          const key = el.getAttribute('data-i18n');
          if (key && dict[key] !== undefined) {
            el.textContent = dict[key];
          }
        });

        // Translate placeholders
        document.querySelectorAll('[data-i18n-placeholder]').forEach(el => {
          const key = el.getAttribute('data-i18n-placeholder');
          if (key && dict[key] !== undefined) {
            (el as HTMLInputElement | HTMLTextAreaElement).placeholder = dict[key];
          }
        });

        // Update html lang attribute
        document.documentElement.lang = lang === 'pt' ? 'pt-BR' : 'en';

        // Update toggle label
        const label = document.getElementById('lang-label');
        if (label) label.textContent = lang === 'pt' ? 'EN' : 'PT';
      }

      // Apply on load
      const currentLang = getLang();
      applyTranslations(currentLang);

      // Wire up toggle
      const toggleBtn = document.getElementById('lang-toggle');
      toggleBtn?.addEventListener('click', () => {
        const current = getLang();
        const next: Lang = current === 'pt' ? 'en' : 'pt';
        localStorage.setItem(STORAGE_KEY, next);
        applyTranslations(next);
      });
    </script>
  </body>
</html>
