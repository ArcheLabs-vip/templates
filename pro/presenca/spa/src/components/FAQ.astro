---
import { faq } from '../data/site';
---
<section class="section" aria-labelledby="faq-title">
  <div class="container centered">
    <div class="faq-wrap">
      <div class="faq-heading">
        <div class="text-box-m" style="text-align:left;">
          <div class="eyebrow-wrap">
            <span class="eyebrow-text">FAQ</span>
          </div>
          <div class="text-box-m">
            <div class="overflow-hidden">
              <h2 id="faq-title" class="heading-h2 slide-up">
                Your Spa <span class="highlight"><br/>Questions Answered</span>
              </h2>
            </div>
          </div>
        </div>
      </div>
      <div class="spacer-32"></div>
      <div class="faq-items">
        {faq.map((item, i) => (
          <div class="faq-item fade-in" data-faq>
            <button class="faq-question heading-h4 no-margin" aria-expanded="false">
              {item.question}
              <svg class="open-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
            </button>
            <div class="faq-answer">
              <div class="faq-answer-inner">
                <p class="paragraph paragraph-large no-margin">{item.answer}</p>
              </div>
            </div>
          </div>
        ))}
        <div class="spacer-32"></div>
        <div class="info-wrap fade-in">
          <div class="info-icon-wrap">
            <svg class="info-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>
          </div>
          <p class="paragraph no-margin" style="text-align:right;font-weight:600;">Ask us about membership perks.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('[data-faq]').forEach(item => {
    const btn = item.querySelector('.faq-question');
    btn?.addEventListener('click', () => {
      const isOpen = item.classList.toggle('is-open');
      btn.setAttribute('aria-expanded', String(isOpen));
    });
  });
</script>
