---
import { site } from '../data/site';
---
<section id="contact" class="section section-white" aria-labelledby="contact-title">
  <div class="container">
    <h2 id="contact-title" class="heading-h2 text-centered fade-in">
      {site.contact.title} <span class="highlight">{site.contact.highlight}</span>
    </h2>
    <div class="spacer-32"></div>
    <div class="grid grid-d70">
      <div class="contact-left">
        <div class="eyebrow-wrap">
          <span class="eyebrow-text">Contact</span>
        </div>
        <h3 class="heading-h3">{site.contact.formTitle}</h3>
        <p class="paragraph paragraph-large">{site.contact.formSubtitle}</p>
        <form class="contact-form" id="contact-form" name="contact" method="POST">
          <input class="text-field" type="text" name="name" placeholder="Your Name" maxlength="256" />
          <input class="text-field" type="email" name="email" placeholder="Your Email" required maxlength="256" />
          <textarea class="text-field text-area" name="message" placeholder="Your Message" maxlength="5000"></textarea>
          <button type="submit" class="button button-dark" style="width:100%;">Submit</button>
        </form>
        <div class="form-done" id="form-done">
          <p>Thank you! Your submission has been received!</p>
        </div>
        <div class="form-fail" id="form-fail">
          <p>Oops! Something went wrong while submitting the form.</p>
        </div>
      </div>
      <div class="contact-right">
        <div class="contact-image-wrap">
          <img src={site.contact.image} alt="Contact us" class="contact-image" loading="lazy" decoding="async" />
        </div>
        <div class="bottom-col-wrap">
          <div class="socials-outer">
            <h4 class="heading-h5 no-margin">Follow us on <span class="highlight">Socials</span></h4>
            <div class="socials-wrap">
              {site.socials.map(social => (
                <a href={social.href} target="_blank" rel="noopener noreferrer" class="social-icon-link" aria-label={social.name}>
                  <div class="beige-icon-wrap">
                    <img src={social.icon} alt={social.name} class="icon-size" loading="lazy" />
                  </div>
                </a>
              ))}
            </div>
          </div>
          <div class="logo-icon-wrap">
            <img src={site.iconLogo} alt={site.name} class="logo-icon" loading="lazy" />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const done = document.getElementById('form-done');
  const fail = document.getElementById('form-fail');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    // Demo behavior: just show success
    form.style.display = 'none';
    if (done) done.style.display = 'block';
  });
</script>
