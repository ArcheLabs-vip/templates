---
import { treatments } from '../data/site';
---
<section class="section" aria-labelledby="treatments-title">
  <div class="container centered">
    <div class="eyebrow-wrap">
      <span class="eyebrow-text">TREATMENTS</span>
    </div>
    <h2 id="treatments-title" class="heading-h2 text-centered fade-in">Client Favourites</h2>
    <div class="text-box-m">
      <p class="paragraph paragraph-large paragraph-centered fade-in">Enjoy hot stone massages and facials, loved by fellow spa-goers.</p>
      <div class="spacer-64"></div>
    </div>
    <div class="grid grid-3">
      {treatments.map(treatment => (
        <a href={`/treatments/${treatment.slug}`} class="treatment-card slide-up">
          <div class="treatment-image-wrap">
            <img src={treatment.image} alt={treatment.title} class="treatment-thumbnail" loading="lazy" decoding="async" />
          </div>
          <h3 class="heading-h4">{treatment.title}</h3>
          <p class="paragraph">{treatment.description}</p>
          <div class="treatment-btn-wrap">
            <span class="button button-no-underline">Learn More</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
