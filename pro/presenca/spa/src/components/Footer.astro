---
import { site, navigation } from '../data/site';
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-col">
        <p class="footer-copyright">© {site.name} Template</p>
        <p class="paragraph" style="padding-right:32px;">Made by <a href="http://tomsweb.site" target="_blank" class="footer-link" style="text-decoration:underline;display:inline;">Toms Design</a> Powered by <a href="https://webflow.com/" target="_blank" class="footer-link" style="text-decoration:underline;display:inline;">Webflow</a></p>
      </div>
      <div class="footer-col">
        <h4 class="footer-col-heading">Pages</h4>
        {navigation.map(link => (
          <a href={link.href} class="footer-link">{link.label}</a>
        ))}
      </div>
      <div class="footer-col">
        <h4 class="footer-col-heading">Admin</h4>
        <a href="/admin/licensing" class="footer-link">Licensing</a>
        <a href="/admin/change-log" class="footer-link">Change Log</a>
        <a href="/admin/style-guide" class="footer-link">Style Guide</a>
      </div>
      <div class="footer-col">
        <h4 class="footer-col-heading">Contact</h4>
        <a href="tel:+15550000000" class="footer-link">Phone: {site.phone}</a>
        <a href={`mailto:${site.email}`} class="footer-link">Email: {site.email}</a>
      </div>
    </div>
    <div class="footer-logo">LotusW</div>
  </div>
</footer>
