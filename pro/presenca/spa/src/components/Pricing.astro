---
import { packages, site } from '../data/site';
---
<section class="section" aria-labelledby="pricing-title">
  <div class="container centered">
    <div class="eyebrow-wrap">
      <span class="eyebrow-text">PRICING</span>
    </div>
    <h2 id="pricing-title" class="heading-h2 text-centered fade-in">
      Explore Our <span class="highlight">Spa Packages</span>
    </h2>
    <div class="text-box-s">
      <p class="paragraph paragraph-large paragraph-centered fade-in">Discover the Perfect Package for Your Relaxation Needs.</p>
    </div>
    <div class="spacer-32"></div>
    <div class="grid grid-1-2" style="gap:0;max-width:1000px;width:100%;">
      <div class="left-col full-height">
        <div class="pricing-image-wrap">
          <img src="https://cdn.prod.website-files.com/67e50bd19f5ad99a1eeb8958/67f513cfbe950a994b1d066c_pricing-image-2.webp" alt="Spa pricing" class="parallax-image" loading="lazy" decoding="async" />
        </div>
      </div>
      <div class="right-col">
        <div class="pricing-plans">
          <img src={site.logo} alt={site.name} class="pricing-logo" />
          <div class="spacer-64"></div>
          {packages.map(pkg => (
            <div class="package-item">
              <div class="beige-icon-wrap beige-icon-wrap-light">
                <img src={pkg.icon} alt={pkg.name} class="icon-size" loading="lazy" />
              </div>
              <div class="package-name-wrap">
                <h3 class="heading-h4 no-margin">{pkg.name}</h3>
                <p class="paragraph paragraph-large no-margin">{pkg.duration}</p>
              </div>
              <p class="paragraph paragraph-large no-margin">{pkg.price}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
    <div class="spacer-32"></div>
    <div class="custom-pricing">
      <h3 class="heading-h4 no-margin">Looking for a custom spa experience?</h3>
      <a href="#contact" class="button button-dark">Contact Us</a>
    </div>
  </div>
</section>
