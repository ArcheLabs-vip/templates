---
import { site } from '../data/site';
---
<section class="section" aria-labelledby="skincare-title">
  <div class="container">
    <div class="grid grid-64">
      <div class="left-col">
        <div class="skin-image-wrap">
          <img src={site.skinCare.image} alt="Skin treatment" class="skin-image" loading="lazy" decoding="async" />
        </div>
      </div>
      <div class="right-col">
        <div class="eyebrow-wrap">
          <span class="eyebrow-text">TREATMENTS</span>
        </div>
        <h2 id="skincare-title" class="heading-h2 fade-in">
          {site.skinCare.title} <span class="highlight">{site.skinCare.highlight}</span>
        </h2>
        <div class="text-box-m">
          <p class="paragraph paragraph-large fade-in">{site.skinCare.text}</p>
        </div>
        <div class="overflow-hidden">
          <div class="slide-up" style="display:flex;">
            <a href="/treatments" class="button button-dark">Learn More</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
