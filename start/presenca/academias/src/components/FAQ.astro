---
import { site, questions } from '../data/site';
---
<section id="duvidas" class="section section-white faq" aria-labelledby="faq-title">
  <div class="container faq-container">
    <div class="section-heading">
      <h2 id="faq-title">{site.faq.title}</h2>
      <p>{site.faq.description}</p>
    </div>
    <div class="faq-list">
      {questions.map(item => <details>
        <summary>{item.question}<span aria-hidden="true">+</span></summary>
        <p>{item.answer}</p>
      </details>)}
    </div>
  </div>
</section>
<style>
  .faq-container { max-width: 900px; }
  .faq-list { border-top: 1px solid var(--color-border); }
  details { border-bottom: 1px solid var(--color-border); }
  summary { display: flex; justify-content: space-between; align-items: center; gap: 24px; padding: 24px 0; list-style: none; color: var(--color-heading); font-weight: 500; font-size: .95rem; }
  summary::-webkit-details-marker { display: none; }
  summary span { font-size: 1.5rem; font-weight: 400; transition: transform .2s; }
  details[open] summary span { transform: rotate(45deg); }
  details p { max-width: 730px; padding: 0 32px 24px 0; font-size: .9rem; line-height: 1.85; }
</style>
