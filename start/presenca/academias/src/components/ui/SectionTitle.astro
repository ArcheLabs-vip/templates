---
interface Props {
  title: string;
  description?: string;
  as?: "h1" | "h2" | "h3";
  align?: "left" | "center";
  class?: string;
}

const {
  title,
  description,
  as: Heading = "h2",
  align = "left",
  class: className,
}: Props = Astro.props;
---

<header class:list={["section-title", `section-title--${align}`, className]}>
  <Heading>{title}</Heading>
  {description && <p>{description}</p>}
  <slot />
</header>

<style>
  .section-title {
    max-width: 44rem;
  }

  .section-title--center {
    margin-inline: auto;
    text-align: center;
  }

  h1,
  h2,
  h3 {
    margin-block-end: 0;
  }

  h1 {
    max-width: 12ch;
    font-size: var(--font-size-display);
    letter-spacing: -0.045em;
  }

  h2 {
    font-size: var(--font-size-xl);
    letter-spacing: -0.025em;
  }

  h3 {
    font-size: var(--font-size-lg);
  }

  p {
    max-width: 60ch;
    margin-block: var(--space-5) 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-lg);
    text-transform: none;
    font-weight: 400;
  }

  .section-title--center p {
    margin-inline: auto;
  }
</style>
