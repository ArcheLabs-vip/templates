---
import { site, regions } from '../data/site';
import Icon from './Icon.astro';
---
<section id="regioes" class="section section-white regions" aria-labelledby="regions-title">
  <div class="container">
    <div class="section-heading"><h2 id="regions-title">{site.regions.title}</h2><p>{site.regions.description}</p></div>
    <div class="regions-grid">
      {regions.map(region => <article>
        <Icon name="pin" /><h3>{region.title}</h3><p>{region.text}</p>
        <a class="text-link" href="#imoveis" data-region-link={region.title} aria-label={`Explorar a região: ${region.title}`}>Explorar a região <Icon name="arrow" /></a>
      </article>)}
    </div>
  </div>
</section>
<style>
  .regions-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 48px; }
  article { padding: 28px 24px 0 0; border-top: 1px solid var(--color-border); }
  article > :global(svg) { width: 30px; height: 30px; color: var(--color-accent); margin-bottom: 20px; }
  h3 { font-size: 1.3rem; margin-bottom: 14px; }
  article p { font-size: .9rem; line-height: 1.8; max-width: 36ch; margin-bottom: 12px; }
  @media (max-width: 1023px) { .regions-grid { gap: 28px; } article { padding-right: 0; } }
  @media (max-width: 767px) { .regions-grid { grid-template-columns: 1fr; gap: 32px; } article p { max-width: none; } }
</style>
