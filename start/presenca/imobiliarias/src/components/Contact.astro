---
import { site } from '../data/site';
import ContactLink from './ContactLink.astro';
import Icon from './Icon.astro';
---
<section id="contato" class="contact-section" aria-labelledby="contact-title">
  <img class="contact-background" src="/images/contato.webp" width="1600" height="1000" alt="" loading="lazy" decoding="async" />
  <div class="container contact-content">
    <h2 id="contact-title">{site.cta.title}</h2>
    <p>{site.cta.description}</p>
    <ContactLink class="button button-whatsapp"><Icon name="whatsapp" />{site.cta.label}</ContactLink>
  </div>
</section>
