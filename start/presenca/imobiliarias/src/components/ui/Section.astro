---
import type { HTMLTag } from "astro/types";

interface Props {
  as?: HTMLTag;
  tone?: "default" | "muted" | "dark";
  spacing?: "sm" | "md" | "lg";
  class?: string;
  [key: string]: unknown;
}

const {
  as: Tag = "section",
  tone = "default",
  spacing = "md",
  class: className,
  ...attrs
}: Props = Astro.props;
---

<Tag
  class:list={[
    "section",
    `section--${tone}`,
    `section--space-${spacing}`,
    className,
  ]}
  {...attrs}
>
  <slot />
</Tag>

<style>
  .section {
    padding-block: var(--section-spacing);
  }

  .section--default {
    background: var(--color-background);
  }

  .section--muted {
    background: var(--color-surface);
  }

  .section--dark {
    --color-primary: var(--color-dark-text);
    --color-text: var(--color-dark-text);
    --color-text-muted: var(--color-dark-muted);
    --color-surface: var(--color-dark-surface);
    --color-surface-raised: var(--color-dark-raised);
    --color-border: var(--color-dark-border);
    --color-brand: var(--color-dark-brand);
    --color-brand-contrast: var(--color-dark-text);
    --color-accent: var(--color-accent-on-dark);
    --color-accent-hover: var(--color-accent-on-dark-hover);
    --color-accent-contrast: var(--color-dark);
    color-scheme: dark;
    background: var(--color-dark);
    color: var(--color-dark-text);
  }

  .section--space-sm {
    --section-spacing: var(--space-section-sm);
  }

  .section--space-md {
    --section-spacing: var(--space-section);
  }

  .section--space-lg {
    --section-spacing: var(--space-section-lg);
  }
</style>
