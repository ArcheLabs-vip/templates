---
interface Props {
  name?: "book" | "globe" | "brain" | "target" | "user" | "sparkle";
}

const { name = "book" }: Props = Astro.props;
---

<span class="service-icon" aria-hidden="true">
  {
    name === "globe" ? (
      <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10A15.3 15.3 0 0 1 12 2Z"/></svg>
    ) : name === "brain" ? (
      <svg viewBox="0 0 24 24"><path d="M12 2a4 4 0 0 0-4 4v1a3 3 0 0 0-3 3 3 3 0 0 0 1 5.5A4 4 0 0 0 12 19"/><path d="M12 2a4 4 0 0 1 4 4v1a3 3 0 0 1 3 3 3 3 0 0 1-1 5.5A4 4 0 0 1 12 19"/><path d="M12 2v17"/></svg>
    ) : name === "target" ? (
      <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
    ) : name === "user" ? (
      <svg viewBox="0 0 24 24"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
    ) : name === "sparkle" ? (
      <svg viewBox="0 0 24 24"><path d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3Z"/></svg>
    ) : (
      <svg viewBox="0 0 24 24"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/><path d="M8 7h6"/><path d="M8 11h4"/></svg>
    )
  }
</span>

<style>
  .service-icon {
    position: relative;
    display: grid;
    width: 3.4rem;
    aspect-ratio: 1;
    flex: 0 0 auto;
    place-items: center;
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--color-accent) 13%, var(--color-surface-raised));
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-accent) 28%, transparent);
    color: var(--color-accent);
  }

  .service-icon::after {
    position: absolute;
    inset-block-start: -0.25rem;
    inset-inline-end: -0.25rem;
    width: 0.7rem;
    aspect-ratio: 1;
    border-radius: 0.14rem;
    background: var(--color-brand);
    content: "";
  }

  svg {
    width: 1.5rem;
    height: 1.5rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.65;
  }
</style>
