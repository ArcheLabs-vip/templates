---
import { site, navigation, services, officeRegistration } from '../data/site';
import Brand from './Brand.astro';
---
<footer class="site-footer"><div class="container">
  <div class="footer-grid">
    <div class="footer-brand"><Brand /><p>{site.footerDescription}</p>{site.instagram && <a class="text-link" href={site.instagram} target="_blank" rel="noopener noreferrer">Instagram ↗</a>}</div>
    <nav aria-label="Navegação do rodapé"><h2>O escritório</h2><ul>{navigation.map(link => <li><a href={link.href}>{link.label}</a></li>)}<li><a href="/#duvidas">Dúvidas frequentes</a></li></ul></nav>
    <nav aria-label="Áreas de atuação"><h2>Áreas de atuação</h2><ul>{services.map(service => <li><a href={`/#${service.id}`}>{service.title}</a></li>)}</ul></nav>
    <div class="footer-note"><h2>Atendimento</h2><p>Presencial e online,<br />mediante agendamento.</p><a class="text-link" href="/#contato">Informações de contato ↗</a></div>
  </div>
  {officeRegistration.legalName && <p class="office-registration">{officeRegistration.legalName} · {officeRegistration.officeOab}<br />Responsável: {officeRegistration.responsibleName} · {officeRegistration.responsibleOab}</p>}
  <div class="footer-bottom"><p>© {new Date().getFullYear()} {site.name}.</p><div><a href="/privacidade/">Privacidade</a><a href="/termos/">Termos de uso</a></div></div>
</div></footer>
