---
import { site, articles } from '../data/site';
import Icon from './Icon.astro';
---
<section id="conteudos" class="section section-white" aria-labelledby="insights-title">
  <div class="container"><div class="section-heading"><h2 id="insights-title">{site.insights.title}</h2><p>{site.insights.description}</p></div>
    <div class="insights-grid">{articles.map(article => <article class="insight">
      <p class="article-category">{article.category}</p><h3><a href={`/conteudos/${article.slug}/`}>{article.title}</a></h3>
      <p>{article.summary}</p><a class="text-link" href={`/conteudos/${article.slug}/`} aria-label={`Ler conteúdo: ${article.title}`}>Ler conteúdo<Icon name="arrow" /></a>
    </article>)}</div>
  </div>
</section>
