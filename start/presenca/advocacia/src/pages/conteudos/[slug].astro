---
import { articles, site } from '../../data/site';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Booking from '../../components/Booking.astro';
export function getStaticPaths() { return articles.map(article => ({ params: { slug: article.slug }, props: { article } })); }
const { article } = Astro.props;
---
<BaseLayout title={`${article.title} | ${site.name}`} description={article.summary}><Header />
  <main id="conteudo" class="container article-page"><article>
    <a class="text-link" href="/#conteudos">← Voltar aos conteúdos</a>
    <p class="article-category">{article.category}</p><h1>{article.title}</h1><p class="article-lead">{article.summary}</p>
    {article.sections.map(section => <section><h2>{section.title}</h2><p>{section.text}</p></section>)}
    <p class="article-note">Informações gerais sobre o atendimento. Este conteúdo não substitui uma consulta ou a análise individual da situação.</p>
  </article></main><Footer /><Booking />
</BaseLayout>
