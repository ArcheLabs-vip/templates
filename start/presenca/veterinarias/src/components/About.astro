---
import { site } from '../data/site';
---
<section id="sobre" class="section about" aria-labelledby="about-title">
  <div class="container about-grid">
    <div class="about-image"><img src="/images/equipe.webp" width="1200" height="800" alt={site.about.imageAlt} loading="lazy" decoding="async" /></div>
    <div class="about-copy">
      <p class="eyebrow">{site.about.eyebrow}</p>
      <h2 id="about-title">{site.about.title} <em>{site.about.emphasis}</em></h2>
      {site.about.paragraphs.map(paragraph => <p>{paragraph}</p>)}
      <div class="about-values">{site.about.values.map(value => <div><h3>{value.title}</h3><p>{value.text}</p></div>)}</div>
    </div>
  </div>
</section>
