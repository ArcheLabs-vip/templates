---
import { site, navigation, services, officeRegistration } from '../data/site';
import Brand from './Brand.astro';
import Icon from './Icon.astro';
import ContactLink from './ContactLink.astro';
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand"><Brand /><p>{site.footerDescription}</p>{site.instagram && <a class="text-link" href={site.instagram} target="_blank" rel="noopener noreferrer">Instagram ↗</a>}</div>
      <nav aria-label="Navegação do rodapé"><h2>Navegação</h2><ul><li><a href="#inicio">Início</a></li>{navigation.map(link => <li><a href={link.href}>{link.label}</a></li>)}</ul></nav>
      <nav aria-label="Serviços"><h2>Serviços</h2><ul>{services.map(service => <li><a href={`#${service.id}`}>{service.title}</a></li>)}</ul></nav>
      <div class="footer-contact"><h2>Contato</h2><ul>
        {site.address && <li><Icon name="pin" /><span>{site.address}</span></li>}
        <li><Icon name="phone" /><a href={site.phoneHref}>{site.phone}</a></li>
        <li><Icon name="whatsapp" /><ContactLink class="footer-contact-link">Falar com a equipe</ContactLink></li>
        {site.email && <li><Icon name="mail" /><a href={`mailto:${site.email}`}>{site.email}</a></li>}
        {site.hours && <li>{site.hours}</li>}
      </ul></div>
    </div>
    {(officeRegistration.officeCrc || officeRegistration.responsibleName) && <div class="office-registration">
      {officeRegistration.officeCrc && <p>{site.name} · {officeRegistration.officeCrc}</p>}
      {officeRegistration.responsibleName && <p>Responsável técnico: {officeRegistration.responsibleName}{officeRegistration.responsibleCrc && ` · ${officeRegistration.responsibleCrc}`}</p>}
    </div>}
    <div class="footer-bottom"><p>© {new Date().getFullYear()} {site.name}. Todos os direitos reservados.</p><div><a href="/privacidade/">Políticas de Privacidade</a><a href="/termos/">Termos de Uso</a></div></div>
  </div>
</footer>
