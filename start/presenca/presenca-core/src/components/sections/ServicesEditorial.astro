---
import { site } from '../../data/site';
---
<section id="tratamentos" class="section container" aria-labelledby="services-title">
  <h2 id="services-title">{site.services.title}</h2><p class="intro">{site.services.text}</p>
  <div class="services">{site.services.items.map(item => <details><summary><span class="number">{item.number}</span><div class="service-title"><h3>{item.title}</h3><span>{item.subtitle}</span></div><p>{item.text}</p><span class="expand" aria-hidden="true">+</span></summary><div class="service-detail"><p>{item.detail}</p><a class="text-link" href="#contato">Conversar sobre este cuidado <span aria-hidden="true">↗</span></a></div></details>)}</div>
</section>
<style>
  h2 { max-width: 630px; }
  .services { margin-top: 54px; }
  details { border-top: 1px solid var(--color-border); }
  details:last-child { border-bottom: 1px solid var(--color-border); }
  summary { display: grid; grid-template-columns: 40px 1fr 1fr 40px; align-items: center; gap: 30px; padding: 30px 0; }
  .number { font-size: 11px; color: var(--color-accent); }
  .service-title > span { color: var(--color-muted); font-size: 10px; }
  summary p { font-size: 12px; max-width: 345px; }
  .expand { width: 38px; height: 38px; border: 1px solid var(--color-border); border-radius: 50%; display: grid; place-items: center; color: var(--color-accent); font-size: 22px; transition: transform var(--transition); }
  details[open] .expand { transform: rotate(45deg); }
  summary:hover h3 { color: var(--color-accent); }
  .service-detail { padding: 0 70px 30px; max-width: 820px; }
  .service-detail p { font-size: 14px; margin-bottom: 20px; }
  @media (max-width: 767px) { summary { grid-template-columns: 24px 1fr 36px; gap: 13px; padding-block: 26px; } summary p { display: none; } h3 { font-size: 30px; } .service-detail { padding: 0 0 26px 37px; } }
</style>
