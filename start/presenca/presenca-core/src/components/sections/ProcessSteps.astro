---
import { site } from '../../data/site';
---
<section class="section" aria-labelledby="process-title">
  <div class="container process-grid">
    <div class="process-header">
      <h2 id="process-title">{site.process.title}</h2>
    </div>
    <ol>{site.process.items.map((item, i) => <li class={i % 2 !== 0 ? 'indented' : ''}><span class="step-number">0{i + 1}</span><h3>{item.title}</h3><p>{item.text}</p></li>)}</ol>
  </div>
</section>
<style>
  .process-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8%; align-items: start; }
  .process-header h2 { max-width: 500px; }
  ol { margin: 0; padding: 0; list-style: none; position: relative; }
  ol::before { content: ''; position: absolute; left: 20px; top: 0; bottom: 0; width: 1px; background: var(--color-border); }
  li { position: relative; padding: 0 0 48px 64px; }
  li:last-child { padding-bottom: 0; }
  li.indented { padding-left: 120px; }
  .step-number { position: absolute; left: 0; top: 0; width: 40px; height: 40px; display: grid; place-items: center; font-size: 11px; color: var(--color-accent); background: var(--color-background); letter-spacing: .04em; }
  h3 { font-size: 29px; margin-bottom: 12px; }
  li p { font-size: 13px; max-width: 400px; }
  @media (max-width: 767px) {
    .process-grid { grid-template-columns: 1fr; gap: 36px; }
    li.indented { padding-left: 50px; }
    ol::before { left: 16px; }
    li { padding-left: 50px; padding-bottom: 36px; }
    .step-number { width: 32px; height: 32px; font-size: 10px; }
    h3 { font-size: 24px; }
  }
</style>

