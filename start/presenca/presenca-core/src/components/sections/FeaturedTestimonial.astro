---
import { site } from '../../data/site';
---
<section class="testimonial section" aria-label="Depoimento em destaque">
  <div class="container">
    <blockquote>
      <p class="quote">"{site.testimonial.quote}"</p>
      <footer>
        <cite>{site.testimonial.name}</cite>
        <span class="context">{site.testimonial.context}</span>
        {site.testimonial.rating && <span class="rating" aria-label={`Avaliação ${site.testimonial.rating} de 5`}>{'★'.repeat(site.testimonial.rating)}</span>}
      </footer>
    </blockquote>
  </div>
</section>
<style>
  .testimonial { border-top: 1px solid var(--color-border); }
  blockquote { max-width: 820px; }
  .quote { font-family: var(--font-heading); font-size: clamp(32px, 3.8vw, 54px); line-height: 1.15; letter-spacing: -.02em; font-style: italic; }
  footer { display: flex; align-items: center; gap: 18px; margin-top: 36px; font-size: 12px; }
  cite { font-style: normal; font-weight: 600; }
  .context { color: var(--color-muted); }
  .rating { color: var(--color-accent); font-size: 13px; letter-spacing: .06em; }
  @media (max-width: 767px) {
    .quote { font-size: clamp(26px, 7vw, 38px); }
    footer { flex-wrap: wrap; gap: 8px 16px; margin-top: 28px; }
  }
</style>
