---
import { site } from '../../data/site';
---
<footer class="container">
  <div class="footer-top"><a class="wordmark" href="#inicio">{site.name}.</a><p>{site.footer.signature}</p><a class="back" href="#inicio">Voltar ao início <span aria-hidden="true">↑</span></a></div>
  <div class="footer-bottom"><p>{site.demo ? site.footer.notice : `© ${new Date().getFullYear()} ${site.name}. Todos os direitos reservados.`}</p><span>{site.footer.credits}</span></div>
</footer>
<style>
  footer { padding-block: 30px max(90px, calc(70px + env(safe-area-inset-bottom))); }
  .footer-top { display: flex; align-items: center; gap: 35px; padding-bottom: 30px; }
  .wordmark { font: 60px/1 var(--font-heading); letter-spacing: -.06em; }
  .footer-top p, .back { font-size: 12px; }
  .back { margin-left: auto; display: flex; gap: 24px; }
  .footer-bottom { border-top: 1px solid var(--color-border); padding-top: 24px; display: flex; justify-content: space-between; gap: 32px; font-size: 10px; color: var(--color-muted); }
  .footer-bottom p { max-width: 620px; }
  .footer-bottom span { flex-shrink: 0; }
  @media (max-width: 767px) { .footer-top { flex-wrap: wrap; gap: 20px; } .back { margin-left: 0; width: 100%; } .footer-bottom { flex-direction: column; gap: 18px; } }
</style>
