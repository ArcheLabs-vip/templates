---
interface Props { href: string; secondary?: boolean; }
const { href, secondary = false } = Astro.props;
---
<a class:list={['button', { secondary }]} href={href}><slot /><span aria-hidden="true">↗</span></a>
<style>
  .button { display: inline-flex; justify-content: space-between; gap: 32px; align-items: center; min-height: 54px; padding: 15px 23px; background: var(--color-accent); color: var(--color-button-text); font-size: 12px; font-weight: 600; border: 1px solid var(--color-accent); transition: background var(--transition), color var(--transition); }
  .button:hover { background: var(--color-text); }
  .button span { font-size: 19px; line-height: 1; }
  .secondary { background: transparent; color: var(--color-text); border-color: var(--color-border); }
  .secondary:hover { background: var(--color-surface); }
</style>
