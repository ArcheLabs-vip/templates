---
import { site, testimonials } from '../data/site';
import Icon from './Icon.astro';
---
<section id="depoimentos" class="section section-white" aria-labelledby="testimonials-title">
  <div class="container">
    <div class="section-heading">
      <h2 id="testimonials-title">O que dizem nossas pacientes</h2>
      <p>Experiências compartilhadas por quem escolheu se cuidar conosco.</p>
    </div>
    {site.demo ? <div class="testimonials-grid">
      {testimonials.map(testimonial => (
        <figure class="testimonial">
          <Icon name="quote" />
          <blockquote><p>“{testimonial.quote}”</p></blockquote>
          <figcaption><span class="avatar" aria-hidden="true">{testimonial.initials}</span><div><strong>{testimonial.name}</strong><span class="stars" aria-label="5 de 5 estrelas">★★★★★</span></div></figcaption>
        </figure>
      ))}
    </div> : <p class="testimonials-empty">Em breve, novas histórias de cuidado por aqui.</p>}
  </div>
</section>
