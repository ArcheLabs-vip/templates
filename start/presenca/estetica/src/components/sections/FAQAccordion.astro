---
import { site } from '../../data/site';
---
<section class="faq section" aria-labelledby="faq-title"><div class="container"><h2 id="faq-title">{site.faq.title}</h2><div class="questions">{site.faq.items.map(item => <details><summary>{item.question}<span aria-hidden="true">+</span></summary><p>{item.answer}</p></details>)}</div></div></section>
<style>
  .faq { border-top: 1px solid var(--color-border); }
  .questions { max-width: 850px; margin-top: 40px; }
  details { border-bottom: 1px solid var(--color-border); }
  summary { display: flex; justify-content: space-between; align-items: center; gap: 24px; padding: 24px 0; font-size: 14px; }
  summary span { color: var(--color-accent); font-size: 24px; transition: transform var(--transition); }
  details[open] summary span { transform: rotate(45deg); }
  details p { max-width: 700px; padding-bottom: 26px; font-size: 13px; }
</style>
