---
import { site } from '../../data/site';
---
<section id="essencia" class="philosophy section" aria-labelledby="philosophy-title"><div class="container">
  <div class="statement"><p class="eyebrow">{site.philosophy.eyebrow}</p><h2 id="philosophy-title">{site.philosophy.title}</h2><p class="description">{site.philosophy.text}</p><p class="closing">{site.philosophy.closing}</p></div>
  <div class="values">{site.philosophy.values.map(value => <article><h3>{value.title}</h3><p>{value.text}</p></article>)}</div>
</div></section>
<style>
  .philosophy { background: var(--color-surface); }
  .statement { text-align: center; max-width: 780px; margin-inline: auto; }
  .statement h2 { font-size: clamp(44px, 5.3vw, 76px); }
  .description { max-width: 550px; margin: 28px auto 20px; }
  .closing { font-size: 12px; color: var(--color-accent); }
  .values { display: grid; grid-template-columns: repeat(3, 1fr); gap: 55px; margin-top: 70px; }
  article { padding-top: 26px; border-top: 1px solid var(--color-border); }
  h3 { font-size: 28px; margin-bottom: 15px; }
  article p { font-size: 12px; max-width: 290px; }
  @media (max-width: 767px) { .values { grid-template-columns: 1fr; gap: 25px; margin-top: 46px; } article p { max-width: none; } }
</style>
