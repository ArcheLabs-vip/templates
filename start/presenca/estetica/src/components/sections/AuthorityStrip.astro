---
import { site } from '../../data/site';
---
<section class="authority" aria-label="Credenciais">
  <div class="authority-inner container">
    {site.authority.items.map((item, i) => <div class="metric"><span class="value">{item.value}</span><span class="label">{item.label}</span></div>)}
  </div>
</section>
<style>
  .authority { padding-block: var(--space-section); border-bottom: 1px solid var(--color-border); }
  .authority-inner { display: flex; gap: clamp(48px, 6vw, 96px); }
  .metric { display: flex; flex-direction: column; gap: 8px; padding-left: clamp(24px, 3vw, 48px); border-left: 1px solid var(--color-border); }
  .metric:first-child { padding-left: 0; border-left: none; }
  .value { font-family: var(--font-heading); font-size: clamp(48px, 4.5vw, 68px); line-height: 1; letter-spacing: -.03em; }
  .label { font-size: 11px; color: var(--color-muted); letter-spacing: .04em; max-width: 120px; }
  @media (max-width: 767px) {
    .authority-inner { flex-direction: column; gap: 28px; }
    .metric { flex-direction: row; align-items: baseline; gap: 18px; padding-left: 0; border-left: none; border-bottom: 1px solid var(--color-border); padding-bottom: 28px; }
    .metric:last-child { border-bottom: none; padding-bottom: 0; }
    .value { font-size: 42px; }
    .label { max-width: none; }
  }
</style>
