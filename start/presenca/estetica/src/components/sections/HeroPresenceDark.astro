---
import { site } from '../../data/site';
import Button from '../ui/Button.astro';
---
<section id="inicio" class="hero" aria-labelledby="hero-title">
  <div class="hero-inner container">
    <div class="hero-copy">
      <p class="eyebrow">{site.hero.eyebrow}</p>
      <h1 id="hero-title">{site.hero.title}<br /><em>{site.hero.accent}</em></h1>
      <p class="hero-description">{site.hero.text}</p>
      <div class="hero-actions">
        <Button href="#contato">{site.contactLabel}</Button>
        <a class="explore" href="#tratamentos">{site.hero.secondaryLabel} <span aria-hidden="true">↓</span></a>
      </div>
    </div>
    <figure>
      <img src={site.hero.image} alt={site.hero.imageAlt} width="1000" height="1500" fetchpriority="high" />
      <figcaption>{site.hero.note}</figcaption>
    </figure>
  </div>
</section>
<style>
  .hero { min-height: 85vh; display: flex; align-items: center; }
  .hero-inner { display: grid; grid-template-columns: 1.15fr 1fr; align-items: center; gap: 6%; padding-block: 48px; }
  .hero-copy { padding-bottom: 20px; }
  h1 { font-size: clamp(72px, 5.5vw, 110px); letter-spacing: -.05em; line-height: .93; }
  h1 em { color: var(--color-accent); font-weight: 400; }
  .hero-description { max-width: 380px; margin: 34px 0 0; font-size: 14px; }
  .hero-actions { display: flex; align-items: center; gap: 32px; margin-top: 36px; }
  .explore { display: flex; align-items: center; gap: 14px; font-size: 11px; color: var(--color-muted); letter-spacing: .04em; }
  .explore:hover { color: var(--color-text); }
  figure { position: relative; }
  figure img { height: clamp(500px, 42vw, 620px); object-fit: cover; object-position: 50% 30%; }
  figcaption { margin-top: 12px; color: var(--color-muted); font-size: 10px; letter-spacing: .05em; }
  @media (max-width: 767px) {
    .hero { min-height: auto; }
    .hero-inner { grid-template-columns: 1fr; gap: 30px; padding-top: 30px; padding-bottom: 20px; }
    .hero-copy { padding-bottom: 0; }
    h1 { font-size: clamp(54px, 13vw, 90px); }
    .hero-description { max-width: 440px; }
    .hero-actions { flex-direction: column; align-items: flex-start; gap: 20px; }
    figure img { height: 460px; object-position: 50% 34%; }
    figcaption { position: static; margin-top: 12px; }
  }
</style>
