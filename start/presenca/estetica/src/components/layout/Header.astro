---
import { site } from '../../data/site';
---
<header>
  <div class="container header-inner">
    <a class="brand" href="#inicio"><span>{site.name}<i aria-hidden="true">.</i></span><small>{site.category}</small></a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="navigation">Menu <span aria-hidden="true">☰</span></button>
    <nav id="navigation" aria-label="Navegação principal">
      {site.nav.map(item => <a href={item.href}>{item.label}</a>)}
      <a class="nav-contact" href="#contato">{site.contactLabel}<span aria-hidden="true">↗</span></a>
    </nav>
  </div>
</header>
<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.querySelector<HTMLElement>('#navigation');
  if (toggle && nav) {
    toggle.hidden = false;
    nav.classList.add('enhanced');
    const close = () => { toggle.setAttribute('aria-expanded', 'false'); nav.classList.remove('is-open'); };
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') !== 'true';
      toggle.setAttribute('aria-expanded', String(open));
      nav.classList.toggle('is-open', open);
    });
    nav.querySelectorAll('a').forEach(link => link.addEventListener('click', close));
    document.addEventListener('keydown', event => { if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') { close(); toggle.focus(); } });
    matchMedia('(min-width: 900px)').addEventListener('change', close);
  }
</script>
<style>
  header { position: relative; z-index: var(--layer-navigation); border-bottom: 1px solid var(--color-border); }
  .header-inner { display: flex; align-items: center; justify-content: space-between; min-height: 80px; gap: 32px; }
  .brand { display: flex; align-items: center; gap: 22px; }
  .brand > span { font-family: var(--font-heading); font-size: 48px; line-height: 1; letter-spacing: -.06em; }
  .brand i { font-style: normal; color: var(--color-accent); }
  .brand small { max-width: 90px; font-size: 9px; text-transform: uppercase; letter-spacing: .17em; line-height: 1.6; }
  nav { display: flex; align-items: center; gap: 32px; font-size: 12px; }
  nav a { padding-block: 12px; }
  nav a:hover { color: var(--color-accent); }
  .nav-contact { margin-left: 18px; border-bottom: 1px solid var(--color-accent); display: flex; gap: 25px; }
  .menu-toggle { display: none; color: var(--color-text); background: none; border: 1px solid var(--color-border); padding: 10px 14px; }
  @media (max-width: 899px) {
    .header-inner { flex-wrap: wrap; gap: 0; padding-block: 13px; }
    .brand > span { font-size: 42px; }
    .brand small { font-size: 8px; }
    .menu-toggle:not([hidden]) { display: none; gap: 15px; align-items: center; }
    :global(.js) .menu-toggle { display: flex; }
    nav { width: 100%; flex-direction: column; align-items: stretch; gap: 0; padding-top: 16px; }
    nav.enhanced, :global(.js) nav { display: none; }
    nav.is-open, :global(.js) nav.is-open { display: flex; }
    .nav-contact { margin-left: 0; justify-content: space-between; }
  }
</style>
