---
import { site, contactHref, contactReady } from '../data/site';
interface Props { class?: string; treatment?: string; label?: string; }
const { class: className = 'button button-primary', treatment, label } = Astro.props;
const href = contactReady && treatment
  ? `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(`Olá! Gostaria de saber mais sobre ${treatment} no ${site.name}.`)}`
  : contactHref;
---
<a class={className} href={href} data-booking={contactReady ? '' : undefined} data-treatment={treatment} aria-label={label} target={contactReady ? '_blank' : undefined} rel={contactReady ? 'noopener noreferrer' : undefined}>
  <slot />
</a>
