---
interface Props {
  name?: "stethoscope" | "heart" | "brain" | "bone" | "eye" | "baby";
}

const { name = "stethoscope" } = Astro.props;
---

<span class="specialty-icon" aria-hidden="true">
  {name === "stethoscope" && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M4.8 2.3A2 2 0 0 0 3 4.5v1a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2V4.8" />
      <path d="M8 4.8V7.5A5 5 0 0 0 12 12.5" />
      <path d="M4 4.8V7.5a5 5 0 0 0 4 5" />
      <circle cx="12" cy="16" r="2" />
      <path d="M14 16a4 4 0 0 1-4 4 4 4 0 0 1-4-4" />
      <path d="M18 12v1a4 4 0 0 1-4 4" />
      <circle cx="18" cy="10" r="2" />
    </svg>
  )}
  {name === "heart" && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
      <path d="M3.5 12h6l1-3 2 6 1-3h6.5" />
    </svg>
  )}
  {name === "brain" && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 2a4 4 0 0 0-4 4c-2.2 0-4 1.8-4 4a4 4 0 0 0 1 2.65A4 4 0 0 0 8 20h4" />
      <path d="M12 2a4 4 0 0 1 4 4c2.2 0 4 1.8 4 4a4 4 0 0 1-1 2.65A4 4 0 0 1 16 20h-4" />
      <path d="M12 2v20" />
      <path d="M8 10h8" />
      <path d="M9 14h6" />
    </svg>
  )}
  {name === "bone" && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M18.3 5.7a2.5 2.5 0 0 0-3.5 0l-9.1 9.1a2.5 2.5 0 0 0 0 3.5 2.5 2.5 0 0 0 3.5 0l9.1-9.1a2.5 2.5 0 0 0 0-3.5Z" />
      <path d="M3.5 8.5 2 7l1.5-1.5L5 7" />
      <path d="M20.5 15.5 22 17l-1.5 1.5L19 17" />
      <path d="M3 12l-1 1 1 1" />
      <path d="M21 12l1-1-1-1" />
    </svg>
  )}
  {name === "eye" && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
      <circle cx="12" cy="12" r="3" />
    </svg>
  )}
  {name === "baby" && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M9 12h.01" />
      <path d="M15 12h.01" />
      <path d="M10 16c.5.3 1.5.5 2 .5s1.5-.2 2-.5" />
      <path d="M19 6.3a9 9 0 0 1 1.8 3.9 2 2 0 0 1 0 3.6 9 9 0 0 1-17.6 0 2 2 0 0 1 0-3.6A9 9 0 0 1 12 3c2 0 3.5 1.1 3.5 2.5s-.9 2.5-2 2.5c-.8 0-1.5-.4-1.5-1" />
    </svg>
  )}
</span>

<style>
  .specialty-icon {
    display: grid;
    width: 3.2rem;
    height: 3.2rem;
    place-items: center;
    border-radius: var(--radius-md);
    background: var(--color-accent-subtle, rgba(13, 148, 136, 0.08));
    color: var(--color-accent);
    flex: 0 0 auto;
  }

  svg {
    width: 1.6rem;
    height: 1.6rem;
  }
</style>
