---
import Container from "../ui/Container.astro";
import Section from "../ui/Section.astro";
import SectionTitle from "../ui/SectionTitle.astro";

import type { ServiceItem } from "../../data/site";

interface Props {
  id?: string;
  title: string;
  description?: string;
  services: ServiceItem[];
}

const { id, title, description, services }: Props = Astro.props;
---

<Section id={id} tone="muted">
  <Container>
    <SectionTitle title={title} description={description} />

    <div class="services-grid" style={`--grid-rows: ${Math.ceil((services.length + 1) / 2)}`}>
      {
        services.map((service, index) => (
          <article class:list={["service", "reveal-on-scroll", index === 0 && "service--featured"]}>
            <span class="service__index" aria-hidden="true">
              {String(index + 1).padStart(2, "0")}
            </span>
            <div>
              <h3>{service.title}</h3>
              <p>{service.description}</p>
              {service.detail && <small>{service.detail}</small>}
            </div>
          </article>
        ))
      }
    </div>
  </Container>
</Section>

<style>
  .services-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-rows: repeat(var(--grid-rows, 3), auto);
    grid-auto-flow: column;
    gap: 0 var(--space-7);
    margin-top: var(--space-8);
  }

  .service {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: var(--space-4);
    padding-block: var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .service--featured {
    grid-row: span 2;
    align-content: end;
    min-height: 22rem;
    padding: var(--space-6);
    border: 0;
    border-radius: var(--radius-lg);
    background: var(--color-accent);
    color: var(--color-accent-contrast);
  }

  .service__index {
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    font-variant-numeric: tabular-nums;
    font-weight: 700;
  }

  .service--featured .service__index,
  .service--featured p,
  .service--featured small,
  .service--featured h3 {
    color: inherit;
  }

  h3 {
    margin: 0;
    font-size: clamp(1.25rem, 2vw, 1.6rem);
  }

  p {
    max-width: 36rem;
    margin: var(--space-3) 0 0;
    color: var(--color-text-muted);
  }

  small {
    display: block;
    margin-top: var(--space-4);
    color: var(--color-text-muted);
    font-weight: 700;
  }

  @media (max-width: 47.99rem) {
    .services-grid {
      grid-template-columns: 1fr;
      grid-template-rows: none;
      grid-auto-flow: row;
      gap: 0;
    }

    .service--featured {
      grid-row: auto;
      min-height: 17rem;
      margin-bottom: var(--space-3);
    }
  }
</style>
