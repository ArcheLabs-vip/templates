---
interface Props {
  href?: string;
  variant?: "primary" | "secondary" | "text" | "whatsapp";
  icon?: string;
  size?: "sm" | "md";
  type?: "button" | "submit" | "reset";
  target?: string;
  rel?: string;
  disabled?: boolean;
  class?: string;
  [key: string]: unknown;
}

const {
  href,
  variant = "primary",
  icon,
  size = "md",
  type = "button",
  target,
  rel,
  disabled = false,
  class: className,
  ...attrs
} = Astro.props;

const classList = ["button", `button--${variant}`, `button--${size}`, className];
const safeRel = target === "_blank" ? rel ?? "noreferrer" : rel;
---

{
  href ? (
    <a
      class:list={classList}
      href={disabled ? undefined : href}
      target={target}
      rel={safeRel}
      aria-disabled={disabled ? "true" : undefined}
      {...attrs}
    >
      {icon && <img class="button__icon" src={icon} alt="" width="18" height="18" aria-hidden="true" />}
      <slot />
    </a>
  ) : (
    <button class:list={classList} type={type} disabled={disabled} {...attrs}>
      {icon && <img class="button__icon" src={icon} alt="" width="18" height="18" aria-hidden="true" />}
      <slot />
    </button>
  )
}

<style>
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: 2.75rem;
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    font-weight: 650;
    line-height: 1;
    text-align: center;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition:
      background-color var(--transition-base),
      border-color var(--transition-base),
      color var(--transition-base),
      transform var(--transition-fast);
  }

  .button:active:not(:disabled, [aria-disabled="true"]) {
    transform: translateY(1px);
  }

  .button--sm {
    min-height: 2.375rem;
    padding-inline: var(--space-4);
    font-size: var(--font-size-sm);
  }

  .button--md {
    padding-inline: var(--space-5);
  }

  .button--primary {
    background: var(--color-accent);
    color: var(--color-accent-contrast);
  }

  .button--primary:hover:not(:disabled, [aria-disabled="true"]) {
    background: var(--color-accent-hover);
  }

  .button--whatsapp {
    background: var(--color-whatsapp, #25d366);
    box-shadow: var(--shadow-action, 0 8px 22px rgb(37 211 102 / 0.2));
    color: var(--color-whatsapp-contrast, #10291b);
  }

  .button--whatsapp:hover:not(:disabled, [aria-disabled="true"]) {
    background: var(--color-whatsapp-hover, #20bd5a);
    transform: translateY(-1px);
  }

  .button__icon {
    width: 1.1rem;
    height: 1.1rem;
    flex: 0 0 auto;
    object-fit: contain;
  }

  .button--secondary {
    border-color: var(--color-border);
    background: transparent;
    color: var(--color-text);
  }

  .button--secondary:hover:not(:disabled, [aria-disabled="true"]) {
    border-color: var(--color-text-muted);
    background: var(--color-surface);
  }

  .button--text {
    min-height: auto;
    padding-inline: 0;
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .button:disabled,
  .button[aria-disabled="true"] {
    opacity: 0.55;
    cursor: not-allowed;
  }
</style>
