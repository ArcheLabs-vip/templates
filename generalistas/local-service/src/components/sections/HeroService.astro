---
import Button from "../ui/Button.astro";
import Container from "../ui/Container.astro";

interface Action {
  label: string;
  href: string;
  variant?: "primary" | "secondary" | "text" | "whatsapp";
  icon?: string;
}

interface Props {
  eyebrow?: string;
  title: string;
  description: string;
  image: string;
  imageAlt: string;
  primaryAction: Action;
  secondaryAction?: Action;
}

const {
  eyebrow,
  title,
  description,
  image,
  imageAlt,
  primaryAction,
  secondaryAction,
}: Props = Astro.props;
---

<section class="hero-service">
  <Container size="wide" class="hero-service__grid">
    <div class="hero-service__content reveal-on-scroll">
      {eyebrow && <p class="hero-service__eyebrow">{eyebrow}</p>}
      <h1>{title}</h1>
      <p class="hero-service__description">{description}</p>
      <div class="hero-service__actions">
        <Button href={primaryAction.href} variant={primaryAction.variant} icon={primaryAction.icon}>
          {primaryAction.label}
        </Button>
        {
          secondaryAction && (
            <Button
              href={secondaryAction.href}
              variant={secondaryAction.variant ?? "secondary"}
              icon={secondaryAction.icon}
            >
              {secondaryAction.label}
            </Button>
          )
        }
      </div>
    </div>

    <div class="hero-service__media reveal-on-scroll reveal-delay-200">
      <img
        src={image}
        alt={imageAlt}
        width="1536"
        height="1024"
        fetchpriority="high"
      />
    </div>
  </Container>
</section>

<style>
  .hero-service {
    display: grid;
    min-height: calc(100dvh - 4.375rem);
    align-items: center;
    padding-block: clamp(2.5rem, 6vw, 5rem);
    overflow: clip;
  }

  .hero-service__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(26rem, 1.18fr);
    align-items: center;
    gap: clamp(2rem, 6vw, 6rem);
  }

  .hero-service__content {
    position: relative;
    z-index: 1;
    padding-inline-start: clamp(0rem, 3vw, 3rem);
  }

  .hero-service__eyebrow {
    padding-inline-start: var(--space-3);
    margin: 0 0 var(--space-5);
    border-inline-start: 1px solid var(--color-accent);
    color: var(--color-accent);
    font-size: var(--font-size-sm);
    font-weight: 750;
    letter-spacing: 0.015em;
  }

  h1 {
    max-width: 11ch;
    margin: 0;
    font-size: var(--font-size-display);
    letter-spacing: -0.065em;
  }

  .hero-service__description {
    max-width: 34rem;
    margin: var(--space-5) 0 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-lg);
  }

  .hero-service__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .hero-service__media {
    position: relative;
    min-height: clamp(28rem, 66vh, 44rem);
  }

  .hero-service__media::before {
    position: absolute;
    inset: 8% -7% -5% 23%;
    z-index: -1;
    border-radius: var(--radius-lg);
    background: var(--color-accent);
    content: "";
  }

  img {
    width: 100%;
    height: 100%;
    min-height: inherit;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    object-fit: cover;
    object-position: 54% center;
  }

  @media (max-width: 63.99rem) {
    .hero-service__grid {
      grid-template-columns: minmax(0, 0.9fr) minmax(22rem, 1.1fr);
      gap: var(--space-7);
    }

    h1 {
      font-size: clamp(2.6rem, 6vw, 4.5rem);
    }
  }

  @media (max-width: 47.99rem) {
    .hero-service {
      min-height: auto;
      padding-block: var(--space-7) var(--space-8);
    }

    .hero-service__grid {
      width: min(calc(100% - (var(--container-gutter) * 2)), var(--container-wide));
      grid-template-columns: 1fr;
      gap: var(--space-7);
    }

    .hero-service__content {
      padding-inline-start: 0;
    }

    h1 {
      max-width: 12ch;
      font-size: clamp(2.55rem, 13vw, 4rem);
    }

    .hero-service__actions {
      align-items: stretch;
      flex-direction: column;
    }

    .hero-service__media {
      min-height: 24rem;
    }

    .hero-service__media::before {
      inset: 10% -1rem -1rem 28%;
    }
  }
</style>
