---
import BenefitsChecklist from "../components/sections/BenefitsChecklist.astro";
import CTABanner from "../components/sections/CTABanner.astro";
import FAQAccordion from "../components/sections/FAQAccordion.astro";
import HeroService from "../components/sections/HeroService.astro";
import ProcessSteps from "../components/sections/ProcessSteps.astro";
import ServicesGrid from "../components/sections/ServicesGrid.astro";
import TestimonialsFeatured from "../components/sections/TestimonialsFeatured.astro";
import QuickContact from "../components/local-business/QuickContact.astro";
import ServiceArea from "../components/local-business/ServiceArea.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  benefits,
  faq,
  process,
  serviceAreas,
  services,
  site,
  testimonials,
} from "../data/site";

const businessSchema = {
  "@context": "https://schema.org",
  "@type": "HomeAndConstructionBusiness",
  name: site.name,
  description: site.description,
  url: site.url,
  telephone: site.contact.phone,
  email: site.contact.email,
  areaServed: serviceAreas,
  address: {
    "@type": "PostalAddress",
    addressLocality: "São Paulo",
    addressRegion: "SP",
    addressCountry: "BR",
  },
};
---

<BaseLayout>
  <Fragment slot="head">
    <link rel="preload" as="image" href="/images/hero-atendimento-v2.webp" fetchpriority="high" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(businessSchema)} />
  </Fragment>

  <HeroService
    eyebrow="Manutenção residencial em São Paulo"
    title="Sua casa em ordem."
    description="Reparos e instalações com agendamento claro, cuidado e orçamento antes do serviço."
    image="/images/hero-atendimento-v2.webp"
    imageAlt="Profissional de manutenção cumprimenta moradora antes do atendimento"
    primaryAction={{
      label: "Pedir orçamento",
      href: site.contact.whatsappHref,
      variant: "whatsapp",
      icon: "/icons/whatsapp.svg",
    }}
    secondaryAction={{ label: "Ligar agora", href: site.contact.phoneHref }}
  />

  <QuickContact
    title="Precisa resolver hoje?"
    description="Envie fotos do problema e receba uma orientação inicial."
    secondaryText={site.contact.hours}
    action={{
      label: "Pedir orçamento",
      href: site.contact.whatsappHref,
      variant: "whatsapp",
      icon: "/icons/whatsapp.svg",
    }}
  />

  <ServicesGrid
    id="servicos"
    title="Manutenção sem complicação"
    description="Dos pequenos reparos às instalações, encontre o atendimento certo para cada necessidade."
    services={services}
  />

  <BenefitsChecklist
    title="Cuidado do primeiro contato ao acabamento"
    description="Informação clara, execução responsável e respeito pela sua rotina."
    image="/images/servico-eletrico-v2.webp"
    imageAlt="Técnico faz a troca cuidadosa de uma tomada em um apartamento"
    benefits={benefits}
  />

  <ProcessSteps
    id="como-funciona"
    title="Você sabe o que acontece em cada etapa"
    description="Um processo simples para reduzir espera, dúvida e surpresa no atendimento."
    steps={process}
  />

  <TestimonialsFeatured
    id="avaliacoes"
    title="Quem chama, recomenda"
    description="Relatos de quem já resolveu pendências da casa com um atendimento claro e cuidadoso."
    testimonials={testimonials}
  />

  <ServiceArea
    id="area-atendida"
    title="Atendimento perto de você"
    description="Confira os bairros atendidos e consulte a disponibilidade para o seu endereço."
    areas={serviceAreas}
    image="/images/area-atendida-v2.webp"
    imageAlt="Técnico organiza suas ferramentas em um veículo de serviço numa rua arborizada"
    action={{ label: "Consultar meu bairro", href: site.contact.whatsappHref }}
  />

  <FAQAccordion
    id="duvidas"
    title="Dúvidas antes de agendar"
    description="Respostas diretas ajudam o cliente a decidir com mais segurança."
    items={faq}
  />

  <CTABanner
    title="Vamos resolver o que está parado?"
    description="Descreva o serviço e receba a orientação para o próximo passo."
    primaryAction={{
      label: "Pedir orçamento",
      href: site.contact.whatsappHref,
      variant: "whatsapp",
      icon: "/icons/whatsapp.svg",
    }}
  />
</BaseLayout>
